# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
# Used by the app at runtime (serverless-friendly).
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Optional: "Session pooler" / direct connection (port 5432) for drizzle-kit push and the seed script.
# Falls back to DATABASE_URL if unset.
DIRECT_DATABASE_URL=

# Google AI Studio → API key. Server-side only, never exposed to the browser.
GEMINI_API_KEY=
# Model name is read from env, never hardcoded.
GEMINI_MODEL=gemini-3.5-flash
